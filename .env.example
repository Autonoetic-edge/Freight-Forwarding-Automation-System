# Application
APP_NAME="Freight Forwarding System"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-min-32-characters
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/freight_db
DB_HOST=db
DB_PORT=5432
DB_NAME=freight_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourcompany.com
SMTP_FROM_NAME=Freight Forwarding System

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SMS (Twilio or MSG91)
SMS_PROVIDER=twilio
TWILIO_PHONE_NUMBER=+1234567890
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=FRTFWD

# File Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx,xls,xlsx

# OCR
OCR_ENABLED=true
TESSERACT_PATH=/usr/bin/tesseract
OCR_LANGUAGE=eng
OCR_CONFIDENCE_THRESHOLD=80

# Browser Automation
SELENIUM_ENABLED=true
CHROME_DRIVER_PATH=/usr/bin/chromedriver
HEADLESS_BROWSER=true
BROWSER_TIMEOUT=30
MAX_CONCURRENT_BROWSERS=3

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
ENABLE_2FA=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# Monitoring
SENTRY_DSN=
ENABLE_METRICS=true

# Backup
BACKUP_ENABLED=true
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
